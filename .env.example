# ==============================================================================
# KAVACH — Intelligent Cybersecurity Platform Configuration (.env)
# ==============================================================================

# Core Ports and Network Bindings
KAVACH_BACKEND_HOST=127.0.0.1
KAVACH_BACKEND_PORT=8000
KAVACH_FRONTEND_HOST=127.0.0.1
KAVACH_FRONTEND_PORT=5173

# Security & CORS
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Connection (SQLite WAL default; PostgreSQL capable)
# SQLite: sqlite+aiosqlite:///./data/database/kavach.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/kavach
DATABASE_URL=sqlite+aiosqlite:///./data/database/kavach.db

# Machine Learning — Isolation Forest Anomaly Detection
ML_ENABLED=true
ML_CONTAMINATION=0.05
ML_MIN_TRAIN_SAMPLES=500
ML_RETRAIN_INTERVAL_HOURS=24

# Raksha AI Assistant — NVIDIA NIM Integration (Offline Heuristic Fallback if empty)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct

# Telemetry Collectors
COLLECTORS_ENABLED=true
COLLECTORS_INTERVAL_SECONDS=30

# Demo Environment Isolation
DEMO_MODE=false

