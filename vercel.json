{
  "outputDirectory": "kavach-frontend",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/dashboard", "destination": "/user.html" },
    { "source": "/user", "destination": "/user.html" },
    { "source": "/soc", "destination": "/soc.html" },
    { "source": "/analyst", "destination": "/soc.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin-login", "destination": "/admin-login.html" },
    { "source": "/raksha", "destination": "/raksha-ai.html" },
    { "source": "/raksha-ai", "destination": "/raksha-ai.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/download", "destination": "/download.html" },
    { "source": "/security", "destination": "/security.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/get-started", "destination": "/get-started.html" },
    { "source": "/api/:path*", "destination": "https://api.kavachcybertech.in/api/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
