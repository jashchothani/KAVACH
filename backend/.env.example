# ============================================================
# KAVACH SOAR-XDR Backend — Environment Configuration
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SIMULATION_MODE=false

# --- Database (SQLite default, PostgreSQL for production) ---
# DB_URL=sqlite+aiosqlite:///kavach.db
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/kavach
DB_ECHO=false

# --- Redis (optional, for Redis Streams queue) ---
QUEUE_TYPE=memory
REDIS_URL=redis://localhost:6379/0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=60

# --- Security ---
SECRET_KEY=CHANGE-ME-TO-A-LONG-RANDOM-STRING-IN-PRODUCTION
JWT_SECRET=CHANGE-ME-TO-ANOTHER-LONG-RANDOM-STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- AI / LLM ---
GEMINI_API_KEY=your-gemini-api-key-here
AI_GEMINI_MODEL=gemini-2.0-flash
AI_GEMINI_RPM=5
AI_GEMINI_TPM=250000
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Threat Intelligence ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GEOIP_DB_PATH=

# --- Notification ---
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SOC_EMAIL=
SOC_PHONE=

# --- Collectors ---
COLLECTION_INTERVAL=30
FIM_DIRECTORY=
CANARY_DIRECTORY=
QUARANTINE_DIRECTORY=

# --- Paths ---
RULE_PATH=rules/definitions
MITRE_DB=mitre/enterprise-attack.json
MODEL_PATH=ml/models
