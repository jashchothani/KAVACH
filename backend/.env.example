# ============================================================
# KAVACH SOAR-XDR Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real secrets to version control.

# --- Application ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SIMULATION_MODE=false

# --- Database (SQLite default, PostgreSQL for production) ---
# DB_URL=sqlite+aiosqlite:///kavach.db
DB_ECHO=false

# --- Redis (optional) ---
QUEUE_TYPE=memory
REDIS_URL=redis://localhost:6379/0

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
RATE_LIMIT_PER_MINUTE=60

# --- Security ---
SECRET_KEY=CHANGE-ME-generate-a-random-64-char-string
JWT_SECRET=CHANGE-ME-generate-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# --- AI / LLM ---
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-flash-latest
AI_GEMINI_RPM=5
AI_GEMINI_TPM=250000
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Threat Intelligence ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
GEOIP_DB_PATH=

# --- Notification (Resend & Gmail SMTP) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=KAVACH Security <security@yourdomain.com>
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SOC_EMAIL=
SOC_PHONE=

# --- Monitored Directories ---
FIM_DIRECTORY=C:\KAVACH\monitored
CANARY_DIRECTORY=C:\KAVACH\canary
QUARANTINE_DIRECTORY=C:\KAVACH\quarantine

# --- Paths ---
RULE_PATH=rules/definitions
MITRE_DB=mitre/enterprise-attack.json
MODEL_PATH=ml/models

# --- NVIDIA NIM (Raksha AI Neural Engine) ---
NVIDIA_NIM_API_KEY=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
